{
  "name": "maximize-musik",
  "private": true,
  "version": "1.0.0",
  "description": "Maximize Musik — музыка без подписки: веб/PWA, Windows, Telegram Mini App и админ-панель",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --workspace @maximize/api run dev",
    "dev:web": "npm --workspace @maximize/web run dev",
    "seed": "npm --workspace @maximize/api run seed",
    "music:add": "node tools/add-music.mjs",
    "build": "npm --workspace @maximize/web run build",
    "build:web": "npm --workspace @maximize/web run build",
    "build:win": "npm --workspace @maximize/desktop run dist",
    "preview": "node tools/serve-dist.mjs",
    "test:api": "node apps/api/test-api.mjs",
    "typecheck": "npm --workspace @maximize/api run typecheck && npm --workspace @maximize/web run typecheck"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "music-metadata": "^13.0.2",
    "playwright-core": "^1.65.1"
  }
}
