# ─── Сервер ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# Секрет для JWT. Обязательно замени в продакшене на длинную случайную строку.
JWT_SECRET=dev-secret-change-me

# Админ создаётся автоматически при первом запуске, если админов ещё нет.
ADMIN_EMAIL=admin@maximize.local
ADMIN_PASSWORD=admin12345

# ─── База данных ──────────────────────────────────────────────────────────────
# Пусто = локальный SQLite в apps/api/data/app.db (ничего ставить не нужно).
# Для продакшена: строка подключения Supabase (Project Settings → Database → Connection string → URI).
DATABASE_URL=

# ─── Публичные адреса ─────────────────────────────────────────────────────────
# Адрес API (нужен боту для кнопки Mini App).
PUBLIC_API_URL=http://localhost:8787
# Адрес веб-приложения (для ссылок в боте и CORS).
WEB_URL=http://localhost:5173
# Через запятую, если нужно ограничить. * — разрешить всем.
CORS_ORIGINS=*

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Токен от @BotFather. Пусто = бот не запускается.
TELEGRAM_BOT_TOKEN=
# Для продакшена: https://<твой-сервис>.onrender.com — тогда бот работает через webhook.
# Пусто = long polling (удобно локально).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# ─── Supabase Storage (необязательно) ────────────────────────────────────────
# Если задано — загруженные обложки и аудио хранятся в Supabase Storage,
# иначе — в локальной папке apps/api/data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=maximize-media
